## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio 2022+
.vs/

# DotNet-specific
project.lock.json
project.fragment.lock.json
artifacts/

# Tye
.tye/

# Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/
.history/
*.code-workspace

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Generated files
Generated_Code/
ClientApp/dist/
ClientApp/node_modules/
wwwroot/lib/
node_modules/
bower_components/
jspm_packages/
typings/

# Backup & reports
*.bak
*.backup
*.BLOB
*.tmp
*.temp
*.log
*.svclog
*.pidb
*.log.json
*.trx
TestResults/
*.VisualState.xml
*.coverage
*.coveragexml
*.testsettings
*.vsmdi

# Publish
*.publish.xml
*.pubxml
*.pubxml.user
publish/
app.publish/

# NuGet
*.nupkg
*.snupkg
*.nuspec
*.nuget.props
*.nuget.targets
packages/
*.lock.json

# Others
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
*.DotSettings

# Azure
*.azurePubxml
*.publishsettings
ServiceDependencies.json
ServiceDependencies.local.json
Connected Services/
local.settings.json

# Entity Framework
Migrations/
*.dbmdl
*.jfm

# SQLite / LocalDB
*.db
*.db-shm
*.db-wal
*.mdf
*.ldf

# Logs & temp
*.tlog
*.log
*.cache
*.pdb

# Build system files
*.msbuild.binlog
msbuild.log

# JetBrains Rider
.idea/
*.sln.iml

# Temporary key files
*.pfx
*.snk
*.cer
*.pem
*.key

# Others
*.bak
*.old
*.orig

# OS-specific
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Ignore secrets and environment config
appsettings.*.json
.env
.env.*
secrets.json

# Unit test output
TestResults/
coverage/
coverage*.json
